<!DOCTYPE html>
<html lang="sk">

<html>

    <head>
        <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track' => true %>
        <%= javascript_include_tag "application" %>
        <%#= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
        <%= csrf_meta_tags %>
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
        <title> Kovo.Space </title>
        <%#= content_for :head %>
    </head>

    <body>

        <noscript>
            <nav class="for_nojs">
                <%= render 'main_menu_top' %>
            </nav>
        </noscript>

        <header class="<%= "#{controller_name}" %>">
            <%= content_for :header %>
        </header>

        <nav class="regular">
            <%= render 'main_menu_top' %>
        </nav>

        <main>
            <%#= content_for :body %>
            <%= yield %>
        </main>

        <footer>
            <%#= content_for :foot %>
        </footer>

     </body>

</html>

