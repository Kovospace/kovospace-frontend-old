<!DOCTYPE html>
<html lang="sk">

<html>

    <head>
        <%= stylesheet_link_tag 'frontend', media: 'all', 'data-turbolinks-track' => true %>
        <%#= stylesheet_link_tag 'frontend', media: 'all' %>
        <%#= javascript_include_tag "application" %>
        <%= javascript_include_tag 'frontend', 'data-turbolinks-track' => true %>
        <%= csrf_meta_tags %>
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
        <title> Kovo.Space </title>
        <%= content_for :head %>
    </head>

    <body class="<%= controller_name.to_s.singularize %>">

        <noscript>
            <nav class="for_nojs">
                <%= render 'main_menu_top' %>
            </nav>
        </noscript>

        <header class="<%= "#{controller_name} #{action_name}" %>">
            <%= content_for :header %>
        </header>

        <nav class="regular">
            <%= render 'main_menu_top' %>
        </nav>

        <main>
            <%#= content_for :body %>
            <%= yield %>
            <section id="foot">
                <%= render 'footer' %>
            </section>
        </main>

        <footer>
            <%= content_for :foot %>
        </footer>

     </body>

</html>

