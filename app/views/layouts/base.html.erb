
<% content_for :header do %>
    <%= stylesheet_link_tag 'frontend', media: 'all', 'data-turbolinks-track' => true %>
    <%= javascript_include_tag 'frontend', 'data-turbolinks-track' => true %>
    <%= csrf_meta_tags %>
    <title> Kovo.Space </title>
    <%= content_for :head %>
<% end %>

<noscript>
    <nav class="for_nojs">
        <%= render 'main_menu_top' %>
    </nav>
</noscript>

<header class="<%= "#{controller_name} #{action_name}" %>">
    <%= content_for :top_menu %>
</header>

<nav class="regular">
    <%= render 'main_menu_top' %>
</nav>

<main>
    <%= yield %>
    <section id="foot">
        <%= render 'footer' %>
    </section>
</main>

<% parent_layout :application %>
