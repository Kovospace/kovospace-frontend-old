<!DOCTYPE html>
<html lang="sk">

    <head>
        <meta charset="utf-8"> 
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
        <%= stylesheet_link_tag '_MAIN', media: 'all', 'data-turbolinks-track' => true %>
        <%= yield(:header) %>
        <% if cookies_not_accepted %>
            <style>
                body { overflow: hidden; }
            </style>
        <% end %>
    </head>

    <body class="<%= controller_name.to_s.singularize %>">
        <p class="notice"><%= notice %></p>
        <p class="alert"><%= alert %></p>
        <%= yield %>
        <% if content_for?(:foot) %>
            <footer>
                <%= content_for :foot %>
            </footer>
        <% end %>
    </body>

</html>


