<!DOCTYPE html>
<html lang="sk">

    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
        <%= stylesheet_link_tag '_MAIN', media: 'all', 'data-turbolinks-track' => true %>
        <%= yield(:header) %>
    </head>

    <body class="<%= controller_name.to_s.singularize %>">
        <p class="notice"><%= notice %></p>
        <p class="alert"><%= alert %></p>
        <%= yield %>
        <footer>
            <%= content_for :foot %>
            <% if @accept_cookie.blank? && action_name != "cookies_info" %>
                <%= render 'cookies_accept' %>
            <% end %>
        </footer>
    </body>

</html>


