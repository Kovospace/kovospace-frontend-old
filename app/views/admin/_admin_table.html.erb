
<%
    if !defined? obj
        var = @result
    else
        var = obj
    end
    cntrl = var.model.name.underscore.pluralize
%>


<table>

    <caption> <%= var.model.model_name.human %> </caption>

    <thead>
        <tr>
            <th></th>
        </tr>
    </thead>

    <tbody>
        <% if var.size > 0 %>
            <% var.each do |row| %>
                <tr>
                    <% fields.each do |field| %>
                        <td> <%= row.send(field) %> </td>
                    <% end %>
                    <td>
                        <%= link_to(
                            "Upraviť",
                            { controller: cntrl, action: :edit, id: row.id },
                            class: "edit_item"
                        ) %>
                    </td>
                    <td>
                        <%= link_to(
                            "Odstrániť",
                            { controller: cntrl, action: :destroy, id: row.id },
                            method: :delete,
                            data: { confirm: 'Isto?' },
                            class: "delete_item"
                        ) %>
                    </td>
                </tr>
            <% end %>
        <% else %>
            <tr class="no_items"> <td> NIČ TU NENI </td> </tr>
        <% end %>
    </tbody>

    <tfoot>
        <tr>
            <th COLSPAN="20">
                <%= link_to(
                    "Pridať novú položku",
                    { controller: cntrl, action: :new },
                    class: "add_item"
                ) %>
            </th>
        </tr>

    </tfoot>

</table>

