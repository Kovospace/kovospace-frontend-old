
<%
    if !defined? obj
        var = @result
    else
        var = obj
    end
    cntrl = var.model.name.underscore.pluralize
%>


<table>

    <caption> <%= var.model.model_name.human %> </caption>

    <thead>
        <tr>
            <th></th>
        </tr>
    </thead>

    <tbody>
        <% if var.size > 0 %>
            <% var.each do |row| %>
                <tr>
                    <% if buttons.include? :seen %>
                        <td>
                            <% if row.seen == true %>
                                <%= link_to(
                                    "-",
                                    { controller: cntrl, action: :unseen, id: row.id },
                                    method: :post,
                                    class: "unseen_item"
                                ) %>
                            <% else %>
                                <%= link_to(
                                    "&#x2022;".html_safe,
                                    { controller: cntrl, action: :seen, id: row.id },
                                    method: :post,
                                    class: "seen_item"
                                ) %>
                            <% end %>
                        </td>
                    <% end %>
                    <% fields.each do |field| %>
                        <td> <%= row.send(field) %> </td>
                    <% end %>
                    <% if buttons.include? :show %>
                        <td>
                            <%= link_to(
                                "Zobraziť",
                                { controller: cntrl, action: :show, id: row.id },
                                class: "show_item"
                            ) %>
                        </td>
                    <% end %>
                    <% if buttons.include? :edit %>
                        <td>
                            <%= link_to(
                                "Upraviť",
                                { controller: cntrl, action: :edit, id: row.id },
                                class: "edit_item"
                            ) %>
                        </td>
                    <% end %>
                    <% if buttons.include? :published %>
                        <td>
                            <% if !row.published %>
                                <%= link_to(
                                    "Publikovať",
                                    { controller: cntrl, action: :publish, id: row.id },
                                    method: :post,
                                    class: "publish_item"
                                ) %>
                            <% else %>
                                <%= link_to(
                                    "Stiahnuť",
                                    { controller: cntrl, action: :suspend, id: row.id },
                                    method: :post,
                                    class: "suspend_item"
                                ) %>
                            <% end %>
                        </td>
                    <% end %>
                    <% if buttons.include? :delete %>
                        <td>
                            <%= link_to(
                                "Odstrániť",
                                { controller: cntrl, action: :destroy, id: row.id },
                                method: :delete,
                                data: { confirm: 'Isto?' },
                                class: "delete_item"
                            ) %>
                        </td>
                    <% end %>
                </tr>
            <% end %>
        <% else %>
            <tr class="no_items"> <td> NIČ TU NENI </td> </tr>
        <% end %>
    </tbody>

    <tfoot>
        <% if buttons.include? :new %>
            <tr>
                <th COLSPAN="20">
                    <%= link_to(
                        "Pridať novú položku",
                        { controller: cntrl, action: :new },
                        class: "add_item"
                    ) %>
                </th>
            </tr>
        <% end %>
    </tfoot>

</table>

