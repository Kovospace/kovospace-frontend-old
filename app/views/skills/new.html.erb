<%= form_for @skill do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>

    <div>
        <%= s.label :description %>
        <%= s.text_area :description %>
    </div>

    <div>
        <%= s.label :degree %>
        <span class="select_wrapper">
            <%= s.collection_select :degree, [1,2,3,4,5], :to_s, :to_s %>
        </span>
    </div>

    <div>
        <%= s.label :theme_color %>
        <%= s.text_field :theme_color %>
    </div>

    <div>
        <%= s.label :icon %>
        <%= s.file_field :icon %>
        <%= s.hidden_field :icon_cache %>
    </div>

    <div class="picture">
        <%= s.label :icon %>
        <picture>
            <%= s.label :icon do %>
                <%= image_tag(s.object.icon) if !s.object.icon.nil? %>
            <% end %>
        </picture>
    </div>

    <div>
        <%= s.label :work_state_id %>
        <span class="select_wrapper">
            <%= s.collection_select :work_state_id, WorkState.all, :id, :title %>
        </span>
    </div>

    <br>

    <div>
        <%= s.submit %>
    </div>

<% end %>
