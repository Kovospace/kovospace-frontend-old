
<article>

    <figure>
        <%= link_to generate_post_url(p) do %>
            <picture>
                <%= image_tag p.avatar.thumb_288p %>
            </picture>
        <% end %>
    </figure>

    <div>
        <%= link_to generate_post_url(p) do %>
            <h3> <%= p.title.html_safe %> </h3>
        <% end %>
        <div> <%= p.intro.html_safe %> </div>
    </div>

    <div>

    </div>

    <br class="clear">

</article>

