
<article>

    <figure>
        <%= link_to generate_post_url(p) do %>
            <%= render(
                'picture',
                picture: p.avatar,
                version: "thumb_big"
            ) %>
        <% end %>
    </figure>

    <div>
        <%= link_to generate_post_url(p) do %>
            <h3> <%= p.title.html_safe %> </h3>
        <% end %>
        <div> <%= p.intro.html_safe %> </div>
    </div>

    <div>

    </div>

    <br class="clear">

</article>

