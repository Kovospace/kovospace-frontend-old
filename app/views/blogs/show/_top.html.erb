<% content_for :header do %>

    <nav class="<%= klass %>">

        <ul class="main">
            <%= blog_topmenu_link home_path, "Domov" %>
            <%= blog_topmenu_link portfolio_path, "Tvorba" %>
        </ul>

        <ol>
            <%= blog_topmenu_link blogs_path, "Blog" %>

            <% if !params[blog_id].blank? %>

                <%= blog_topmenu_link show_blog_path(@blog), @blog.title %>

                <% if !params[post_id].blank? %>

                    <%= blog_topmenu_link show_blog_post_path(@blog, params[:page], @post), @post.title %>

                <% end %>

            <% else %>

                <% if !params[post_id].blank? %>

                    <%= blog_topmenu_link show_post_path(params[:page], @post), @post.title %>

                <% else %>

                    <%= blog_topmenu_link all_posts_path, "Všetky články" %>

                <% end %>

            <% end %>

            <% if !params[blog_id].blank?&&!params[category_id].blank? %>

                <%= blog_topmenu_link show_blog_category_path(@blog, @category, params[:page]), @category.title %>

            <% end %>

            <% if !params[blog_id].blank?&&!params[category_id].blank?&&!params[post_id].blank? %>

                <%= blog_topmenu_link show_blog_category_post_path(@blog, @category, params[:page], @post), @post.title %>

            <% end %>

        </ol>

    </nav>

<% end %>
