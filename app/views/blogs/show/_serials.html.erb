
<h2>Seriály</h2>

<% @blog.categories.each do |category| %>

    <article>

        <figure>
            <picture>
                <%= image_tag category.title_bg.thumb_320p %>
            </picture>
        </figure>

        <%= link_to show_blog_category_path(@blog.slug, category.slug) do %>
            <span><h4><%= category.title %></h4></span>
        <% end %>

    </article>

<% end %>
