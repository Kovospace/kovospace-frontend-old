<%= form_for @blog do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>

    <div>
        <%= s.label :slug %>
        <%= s.text_field :slug %>
    </div>

    <div>
        <%= s.label :description %>
        <%= s.text_area :description %>
    </div>

    <div>
        <%= s.label :title_bg %>
        <%= s.file_field :title_bg %>
        <%= s.hidden_field :title_bg_cache %>
    </div>

    <div class="picture">
        <%= s.label :title_bg %>
        <picture>
            <%= s.label :title_bg do %>
                <%= image_tag(s.object.title_bg) if !s.object.title_bg.nil? %>
            <% end %>
        </picture>
    </div>

    <div class="checkboxes">
        <%= s.label :categories %>
        <div>
            <%= s.collection_check_boxes(
                :category_ids,
                @categories_all,
                :id,
                :title
            ) do |checkbox| %>
                <span>
                    <%= checkbox.label %> <%= checkbox.check_box %>
                </span>
            <% end %>
        </div>
    </div>

    <div>
        <%= s.fields_for :categories, @categories do |t| %>
            <% if t.object.id.blank? %>
                <%= t.label :title %>
                <%= t.text_field :title %>
                <%#= t.errors :title %>
            <% end %>
        <% end %>
        <%#= render(
            'layouts/shared_elements/form_errors_field',
            field: :categories_attributes
        ) %>
    </div>

    <div class="checkboxes">
        <%= s.label :tags %>
        <div>
            <%= s.collection_check_boxes(
                :tag_ids,
                @tags_all,
                :id,
                :title
            ) do |checkbox| %>
                <span>
                    <%= checkbox.label %> <%= checkbox.check_box %>
                </span>
            <% end %>
        </div>
    </div>

    <div>
        <%= s.fields_for :tags, @tags do |t| %>
            <% if t.object.id.blank? %>
                <%= t.label :title %>
                <%= t.text_field :title %>
                <%#= t.errors :title %>
            <% end %>
        <% end %>
        <%#= render(
            'layouts/shared_elements/form_errors_field',
            field: :tags_attributes
        ) %>
    </div>

    <div>
        <%= s.submit %>
    </div>

<% end %>
