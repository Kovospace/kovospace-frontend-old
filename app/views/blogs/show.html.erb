
<%= render 'blogs/show/top', klass: (params[:category_id].blank? ? "maximized" : "minimized") %>

<% if params[:category_id].blank? %>

    <section id="serials">
        <%= render 'blogs/show/serials' %>
    </section>

    <section class="posts best">
        <h2>Top články</h2>
        <% @posts_best.each do |post| %>
            <%= render 'blogs/show/post', p: post %>
        <% end %>
    </section>

    <section class="posts new">
        <h2>Najnovšie</h2>
        <% @posts_new.each do |post| %>
            <%= render 'blogs/show/post', p: post %>
        <% end %>
    </section>

<% else %>

    <section class="posts categorized">

        <figure>
            <picture>
                <%= image_tag @category.title_bg %>
            </picture>
        </figure>

        <h2> <%= @category.title %> </h2>

        <% @posts.each do |post| %>
            <%= render 'blogs/show/post', p: post %>
        <% end %>

    </section>

<% end %>
