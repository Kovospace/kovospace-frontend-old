
<% @blogs.each do |blog| %>

    <article>

        <figure>
            <picture>
                <%= image_tag blog.title_bg.bg_1024 %>
            </picture>
        </figure>

        <h2>
            <%= link_to blog.title, show_blog_path(blog) %>
        </h2>
        <h3>
            <%= link_to blog.description, show_blog_path(blog) %>
        </h3>

        <div class="top_serials"><!--
            --><b><%= link_to "Seriály", show_blog_path(blog) %></b><!--
            --><% blog.categories.each do |category| %><!--
                --><span><a><%= category.title %></a></span><!--
            --><% end %><!--
        --></div>

        <br>

        <div class="top_posts"><!--
            --><b><%= link_to "TOP ćlánky", show_blog_path(blog) %></b><!--
            --><% blog.posts.each do |post| %><!--
                --><span><a><%= post.title %></a></span><!--
            --><% end %><!--
        --></div>

    </article>

<% end %>
