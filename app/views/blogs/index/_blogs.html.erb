
<% @blogs.each do |blog| %>

    <article>

        <h2><%= blog.title %></h2>
        <h3><%= blog.description %></h3>

        <div class="top_serials"><!--
            --><b>Seriály</b><!--
            --><% blog.categories.each do |category| %><!--
                --><span> <%= category.title %> </span><!--
            --><% end %><!--
        --></div>

        <br>

        <div class="top_posts"><!--
            --><b>TOP články</b><!--
            --><% blog.posts.each do |post| %><!--
                --><span> <%= post.title %> </span><!--
            --><% end %><!--
        --></div>

    </article>

<% end %>
