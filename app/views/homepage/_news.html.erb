<aside>
    <%= render 'sputnik', title: "Novinky" %>
</aside>

<article>
        <% @newslogs.each do |newslog| %>

            <h3> <%= newslog.title %> </h3>
            <p> <%= newslog.preview.gsub(/\n/, '<br/>').html_safe %>
                <% if newslog.txt.size > 512 %>
                    <%= "... " %>
                    <%= link_to("zobraziť celý príspevok", show_newslog_path(newslog)) %>
                <% end %>
            <br>
            <em><%= l(newslog.created_at, format: :default) %></em>
            <br>
            <br>

        <% end %>
</article>

<div>
    <%= link_to(I18n.t('newslog.news_count', count: @newslogs_others_count), newslogs_path) %>
</div>
