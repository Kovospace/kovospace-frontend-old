<aside>
    <%= render 'sputnik', title: "Novinky" %>
</aside>

<article>
        <% @newslogs.each do |newslog| %>

            <h3> <%= newslog.title %> </h3>
            <p> <%= newslog.txt.gsub(/\n/, '<br/>') %>
            <br>
            <em><%= l(newslog.created_at, format: :default) %></em>
            <br>
            <br>

        <% end %>
</article>

<div>
    <%= link_to("Viacej...", newslogs_path) %>
</div>
