<aside>
    <%= render 'voyager', title: "skills" %>
</aside>


<% @skills.each do |skill| %>

    <% skill_projects(skill) %>

    <article>

        <div class="projects">
            <%= content_for :homepage_skills_projects_0 %>
        </div>

        <div class="description">
             <figure class="size_<%= skill.degree %> ">
                <div class="bg" style="background-color:#<%= skill.bg %>;"></div>
                <h3>
                    <span> <%= skill.title %> </span>
                </h3>
            </figure>
        </div>

        <div class="projects">
            <%= content_for :homepage_skills_projects_1 %>
        </div>

    </article>

<% end %>

