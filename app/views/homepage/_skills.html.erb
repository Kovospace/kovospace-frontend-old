<h2> Skills </h2>


<% @skills.each do |skill| %>

    <article>

        <figure class="size_<%= skill.degree %> ">
            <div style="background-color:#<%= skill.bg %>; ">
                <picture>
                    <%= image_tag(skill.icon, alt: skill.title) %>
                </picture>
            </div>
        </figure>

        <div class="description">
            <h3> <%= skill.title %> </h3>
            <b>Misie:</b>
            <% skill.portfolios.each do |portfolio| %>
                <%= link_to portfolio.title, portfolio %>
            <% end %>
        </div>

    </article>

<% end %>

