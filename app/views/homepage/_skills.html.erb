<h2> Skills </h2>


<% @skills.each do |skill| %>

    <article>

        <div class="description">
             <figure class="size_<%= skill.degree %> ">
                <div class="bg" style="background-color:#<%= skill.bg %>;"></div>
                <h3>
                    <span> <%= skill.title %> </span>
                </h3>
            </figure>
        </div>

        <div class="projects">
            <% skill.portfolios.each do |portfolio| %>
                <%= link_to(portfolio) do %>
                    <span> <%= portfolio.title %> </span>
                <% end %>
            <% end %>
        </div>

    </article>

<% end %>

