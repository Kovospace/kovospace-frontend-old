<article>

    <%= form_for @contact, url: '/#kontakt' do |c| %>

        <div>
            <span>
                <%= c.text_field(
                    :sender,
                    placeholder: "E-mail"
                ) %>
            </span>
            <%= c.errors :sender %>
        </div>

        <div>
            <span> <%= c.text_field :title, placeholder: "Predmet" %> </span>
        </div>

        <div>
            <span> <%= c.text_area :msg, placeholder: "Správa..." %> </span>
            <%= c.errors :msg %>
        </div>

        <div id="no_sputnik_check">
            <span>
                <%= c.check_box :i_am_not_sputnik %>
            </span>
            <span>
                <%= c.label :i_am_not_sputnik, "Nie som robot alebo som robot s uznaným statusom človeka" %>
                <br>
                <%= c.errors :i_am_not_sputnik, full_msgs: false %>
            </span>
        </div>

        <div id="no_sputnik_check">
            <span>
                <%= c.check_box :accept_gdpr %>
            </span>
            <span>
                <%= c.label :accept_gdpr do %>
                    Súhlasím so spracovaním osobných údajov a rozumiem
                    <%= link_to "politike GDPR", gdpr_path %>
                    platnej na tomto webe
                <% end %>
                <br>
                <%= c.errors :accept_gdpr, full_msgs: false %>
            </span>
        </div>

        <div id="submit_contact">
            <span> <%= c.submit "Odoslať" %> </span>
        </div>

    <% end %>

</article><!--

--><aside>

    <span></span>
    <h2>Kontakt</h2>

</aside>
