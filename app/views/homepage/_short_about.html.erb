
<aside>
    <%= render 'kozmonaut', image: 'me_photo' %>
</aside>

<article>

    <summary>
        <div>
            <i class="icon" id="about_me_info_icon"></i>
        </div>
        <div>Matej Kováč</div>
    </summary>

    <summary>
        <div>
            <i class="icon" id="about_me_home_icon"></i>
        </div>
        <div>Praha, Česká Republika</div>
    </summary>

    <summary>
        <div>
            <i class="icon" id="about_me_work_icon"></i>
        </div>
        <div>
        	<%= @work_experience_current.title %> 
            <%= link_to(@work_experience_current.web, "https://" + @work_experience_current.web) %>
        	<br> <%= @work_experience_current.position %>
        	<br> <%= @work_experience_current.place %>
            <% if @work_experiences.size > 1 %>
                <%= render 'work_experiences/work_experiences' %>
                <%= link_to("predchádzajúce (" + (@work_experiences.size - 1).to_s + ")", work_experiences_path(anchor: 'o-mne'), class: :more, id: :work_experiences_show_more) %>
            <% end %>
        </div>
    </summary>

    <summary>
        <div>
            <i class="icon" id="about_me_education_icon"></i>
        </div>
        <div><a href="https://www.greenfoxacademy.cz/">Green Fox Academy Prague</a></div>
    </summary>

    <summary>
        <div>
            <i class="icon" id="about_me_linkedin_icon"></i>
        </div>
        <div><a href="https://www.linkedin.com/in/kovac-matej/">linkedin.com/in/kovac-matej</a></div>
    </summary>

    <summary>
        <div>
            <i class="icon" id="about_me_github_icon"></i>
        </div>
        <div><a href="https://github.com/K0V0">github.com/K0V0</a></div>
    </summary>

    <summary>
        <div>
            <i class="icon" id="about_me_stackoverflow_icon"></i>
        </div>
        <div><a href="https://stackoverflow.com/users/2856415/kovo">stackoverflow.com/users/2856415/kovo</a></div>
    </summary>

    <summary>
        <div>
            <i class="icon" id="about_me_hobby_icon"></i>
        </div>
        <div>
            Webdesign & programovanie <br>
            PC & hardware, elektronika & bastlenie, garáž & dielňa, DIY <br>
            Cestovanie, turistika, hudba, festivaly & koncerty <br>
            Literatúra, blogging
        </div>
    </summary>

</article>
