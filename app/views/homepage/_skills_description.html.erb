<article>
    <div id="voyager">
        <%= render 'voyager' %>
    </div>
    <div id="skills_description_message">
        <div class="terminal">

        <p>
            <span id="shortinfo_window_title">&lt; terminál &gt; DOJÍŽDER 1</span>

            <% @work_states.each do |work_state| %>

                <% work_state.skills.each do |skill| %>
                    <span
                        class="planet size_<%= skill.degree %> "
                        style="background-color:#<%= skill.bg %>; "
                    >
                        <picture>
                            <%= image_tag(skill.icon, alt: skill.title) %>
                        </picture>
                    </span>
                <% end %>

                <span>
                    <%= work_state.title %>
                    <br>
                    <%= work_state.description %>
                </span>
                <br>

            <% end %>


    </div>


    </div>
</article>
