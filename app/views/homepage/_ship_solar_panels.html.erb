
<div id="ship_solar_panels">
    <nav>
        <ul>

            <li>
                <div class="triangle right"> </div>
                <div class="triangle left"> <span></span> </div>
                <%= link_to portfolio_path do %>
                    <h2> <%= t 'portfolio' %> </h2>
                <% end %>

                <% @skillsets.all.each do |skillset| %>

                    <div class="menuitem_content">

                        <div class="skill_category">
                            <a href="<%= "#{portfolio_url}/#{skillset.slug}" %>">
                                <h3><%= skillset.title %></h3>
                            </a>
                        </div>

                        <div class="projects">
                            <% skillset.portfolios.all.each do |portfolio| %>
                                <%= link_to portfolio.title, show_portfolio_path(portfolio) %>
                            <% end %>
                        </div>

                    </div>

                <% end %>

            </li>

            <li>
                <div class="triangle right"> </div>
                <div class="triangle left"> <span></span></div>
                <%= link_to blog_path do %>
                   <h2> <%= t 'blog' %> </h2>
                <% end %>

                <div class="menuitem_content">

                </div>
            </li>

        </ul>
    </nav>
</div>
