
<%= render 'newslogs/top' %>

<section id="note">

    <article>
        <h1>
            <%= @newslog.title %>
        </h1>
        <em> <%= @newslog.created_at.strftime('%d. %B %Y') %> </em>
        <div>
            <%= @newslog.txt.gsub(/\n/, '<br/>').html_safe %>
        </div>
    </article>

</section>