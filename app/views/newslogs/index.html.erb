
<%= render 'newslogs/top' %>

<section id="news">

    <article>

        <% @newslogs_groupped.each do |group| %>

            <table>

                <caption> <h2><%= group[0].strftime('%Y') %></h2> </caption>

                <tbody>
                    <% group[1].each do |note| %>
                        <tr>
                            <td> <em> <%= l(note.created_at, format: '%B %d.') %> </pre> </pre></em> </td>
                            <td>
                                <%= note.title %>
                                <% if !(txt = note.preview.strip).empty? %>
                                    <%= link_to("Viac...", show_newslog_path(note)) %>
                                <% end %>
                            </td>
                        </tr>
                    <% end %>
                </tbody>

            </table>

        <% end %>

    </article>

</section>
