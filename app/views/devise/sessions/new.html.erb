
<% content_for :top_menu do %>
  <figure class="deathstar"></figure>
<% end %>

<%= render "devise/shared/fighter" %>

<br>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "meno" %>
  </div>

  <div class="field">
    <%= f.password_field :password, autocomplete: "off", placeholder: "heslo" %>
  </div>

  <% if devise_mapping.rememberable? -%>
    <div class="field">
      <%= f.check_box(
        :remember_me,
        disabled: @accept_cookie["personal"] != "1"
      ) %>
      <%= f.label(
        :remember_me,
        "Zapamätať si prihlásenie",
        class: remember_disabled_class
      ) %>
    </div>
  <% end -%>

  <div class="warn">
     <%= cookie_permissions_warn %>
  </div>

  <div class="actions">
    <%= f.submit "Prihlásiť sa" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

<br>

<%= render "devise/shared/fighter" %>
