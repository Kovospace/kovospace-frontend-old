
<% content_for :header do %>
  <figure class="deathstar"></figure>
<% end %>

<%= render "devise/shared/fighter" %>

<br>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "e-mail" %>
  </div>

  <div class="field">
    <%= f.password_field :password, autocomplete: "off", placeholder: "heslo" %>
  </div>

  <% if devise_mapping.rememberable? -%>
    <div class="field">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "Zapamätať si prihlásenie" %>
    </div>
  <% end -%>

  <div class="actions">
    <%= f.submit "Prihlásiť sa" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

<br>

<%= render "devise/shared/fighter" %>
