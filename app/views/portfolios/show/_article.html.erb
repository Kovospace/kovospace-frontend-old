<article>

    <h3> <%= markdown @portfolio.intro %> </h3>
    <br>
    <div> <%= kovodown @portfolio.description %> </div>
    <br>
    <br>
    <h4> Realizácia: <%= l(@portfolio.realis_date, format: :short) %> </h4>

</article>

<br>

<aside>
    <ul>

        <li >
            <a href="<%= "#{portfolio_url}/#{@portfolio.skillset.slug}" %>" <%= @portfolio.style %> class="fakehover">
                <span> <%= @portfolio.skillset.title %> </span>
            </a>
        </li>

        <% @portfolio.skills.each do |skill| %>
            <li>
                <a href="" <%= skill.style %> class="fakehover">
                   <span> <%= skill.title %> </span>
                </a>
            </li>
        <% end %>

    </ul>
</aside>