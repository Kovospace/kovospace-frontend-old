<%
    desktop = :title_bg_desktop
    tablet = :title_bg_tablet
    cell = :title_bg_mobile
%>

<figure class="pc">
    <picture>

        <source
            media="(max-width: 1152px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_desktop_size_l_1x, desktop) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_l_2x, desktop) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_l_3x, desktop) %> 3x"
        >
        <source
            media="(max-width: 800px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_desktop_size_m_1x, desktop) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_m_2x, desktop) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_m_3x, desktop) %> 3x"
        >
        <!-- 640 to iste ako pre 800 -->
        <!-- 480 to iste ako pre 800 -->
        <source
            media="(max-width: 375px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_desktop_size_s_1x, desktop) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_s_2x, desktop) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_s_3x, desktop) %> 3x"
        >
        <source
            media="(max-width: 320px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_desktop_size_xs_1x, desktop) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_xs_2x, desktop) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_m_2x, desktop) %> 3x"
        >
        <!-- ^^ opakovacka pre retina 3x -->

        <img
            src="<%= imageHeaderUrlResponsive(:title_bg_desktop_size_xl_1x, desktop) %>"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_desktop_size_xl_2x, desktop) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_desktop_size_xl_3x, desktop) %> 3x"
        >

    </picture>
</figure>

<figure class="tablet">
    <picture>

        <source
            media="(max-width: 1152px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_tablet_size_l_1x, tablet) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_tablet_size_l_2x, tablet) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_tablet_size_l_3x, tablet) %> 3x"
        >
        <source
            media="(max-width: 800px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_tablet_size_m_1x, tablet) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_tablet_size_m_2x, tablet) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_tablet_size_m_3x, tablet) %> 3x"
        >
        <!-- 640 to iste ako pre 800 -->
        <!-- 480 to iste ako pre 800 -->
        <!-- 375 to iste ako pre 800 -->
        <source
            media="(max-width: 320px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_tablet_size_xs_1x, tablet) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_tablet_size_xs_2x, tablet) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_tablet_size_m_2x, tablet) %> 3x"
        >
        <!-- ^^ opakovacka pre retina 3x -->

        <img
            src="<%= imageHeaderUrlResponsive(:title_bg_tablet_size_xl_1x, tablet) %>"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_tablet_size_xl_2x, tablet) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_tablet_size_xl_3x, tablet) %> 3x"
        >

    </picture>
</figure>

<figure class="cell">
    <picture>

        <source
            media="(max-width: 1152px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_mobile_size_l_1x, cell) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_mobile_size_l_2x, cell) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_mobile_size_l_3x, cell) %> 3x"
        >
        <source
            media="(max-width: 800px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_mobile_size_m_1x, cell) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_mobile_size_m_2x, cell) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_mobile_size_m_3x, cell) %> 3x"
        >
        <!-- 640 to iste ako pre 800 -->
        <!-- 480 to iste ako pre 800 -->
        <source
            media="(max-width: 320px)"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_mobile_size_xs_1x, cell) %>,
                    <%= imageHeaderUrlResponsive(:title_bg_mobile_size_xs_2x, cell) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_mobile_size_m_2x, cell) %> 3x"
        >
        <!-- ^^ opakovacka pre retina 3x -->

        <img
            src="<%= imageHeaderUrlResponsive(:title_bg_mobile_size_xl_1x, cell) %>"
            srcset="<%= imageHeaderUrlResponsive(:title_bg_mobile_size_xl_2x, cell) %> 2x,
                    <%= imageHeaderUrlResponsive(:title_bg_mobile_size_xl_3x, cell) %> 3x"
        >

    </picture>
</figure>