
<%# typ = showsection_decide_titlebg_type(@portfolio) %>

<% typ = :responsive %>

<% if typ == :desktop %>

    <figure class="desktop">

        <picture class="pc">
            <img
                src="<%= imageHeaderUrl(:bg_desktop_size_1x) %>"
                srcset="<%= imageHeaderUrl(:bg_desktop_size_2x) %> 2x,
                        <%= imageHeaderUrl(:bg_desktop_size_3x) %> 3x"
            >
        </picture>

    </figure>

<% elsif typ == :responsive %>

    <div class="preview responsive">

        <figure class="pc">
            <picture>
                <img src="">
                <img
                    src="<%= imageHeaderUrl(:title_bg_desktop_size_1x, :title_bg_desktop) %>"
                    srcset="<%= imageHeaderUrl(:title_bg_desktop_size_2x, :title_bg_desktop) %> 2x,
                            <%= imageHeaderUrl(:title_bg_desktop_size_3x, :title_bg_desktop) %> 3x"
                >
            </picture>
        </figure>

        <figure class="tablet">
            <picture>
                <img src="">
                <img
                    src="<%= imageHeaderUrl(:title_bg_tablet_size_1x, :title_bg_tablet) %>"
                    srcset="<%= imageHeaderUrl(:title_bg_tablet_size_2x, :title_bg_tablet) %> 2x,
                            <%= imageHeaderUrl(:title_bg_tablet_size_3x, :title_bg_tablet) %> 3x"
                >
            </picture>
        </figure>

        <figure class="cell">
            <picture>
                <img src="">
                <img
                    src="<%= imageHeaderUrl(:title_bg_mobile_size_1x, :title_bg_mobile) %>"
                    srcset="<%= imageHeaderUrl(:title_bg_mobile_size_2x, :title_bg_mobile) %> 2x,
                            <%= imageHeaderUrl(:title_bg_mobile_size_3x, :title_bg_mobile) %> 3x"
                >
            </picture>
        </figure>

        <%
            uploader = :title_bg
            versions = [:desktop, :mobile, :tablet]
            sizes = ["1x", "2x", "3x"]
        %>

    </div>

<% end %>

<div>
    <% @portfolio.portfolio_titlebgs.each_with_index do |obj, index| %>

        <% versions.each do |version| %>
            <% sizes.each do |size| %>

                <% namestring = "#{uploader.to_s}_#{version.to_s}_size_#{size.to_s}" %>
                <%= hidden_field_tag(
                    "#{namestring}[#{index.to_s}]",
                    imageHeaderUrl(namestring, "#{uploader.to_s}_#{version.to_s}", obj)
                ) %>

            <% end %>
        <% end %>

    <% end %>
</div>

