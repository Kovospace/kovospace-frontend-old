
<% typ = showsection_decide_titlebg_type(@portfolio) %>

<figure>

    <% if typ == :desktop %>

        <picture <%= @portfolio.style %>>
            <%= image_tag(@title_bgs.first.title_bg) %>
        </picture>

    <% elsif typ == :responsive %>

        <picture <%= @portfolio.style %>>
            <%= image_tag(@title_bgs.first.title_bg) %>
        </picture>

    <% end %>

</figure>
