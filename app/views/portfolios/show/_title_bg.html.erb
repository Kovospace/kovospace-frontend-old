
<%# typ = showsection_decide_titlebg_type(@portfolio) %>

<% typ = :responsive %>

<% if typ == :desktop %>

    <figure class="desktop">

        <picture class="pc">
            <img
                src="<%= imageHeaderUrl(:bg_desktop_size_1x) %>"
                srcset="<%= imageHeaderUrl(:bg_desktop_size_2x) %> 2x,
                        <%= imageHeaderUrl(:bg_desktop_size_3x) %> 3x"
            >
        </picture>

    </figure>

<% elsif typ == :responsive %>

    <div class="preview responsive">

        <figure class="cell">

            <picture class="cell">
                <img src="">
                <img
                    src="<%= imageHeaderUrl(:bg_mobile_size_1x, :title_bg_mobile) %>"
                    srcset="<%= imageHeaderUrl(:bg_mobile_size_2x, :title_bg_mobile) %> 2x,
                            <%= imageHeaderUrl(:bg_mobile_size_3x, :title_bg_mobile) %> 3x"
                >
            </picture>

        </figure>
        <figure class="pc">

            <picture class="pc">
                <img src="">
                <img
                    src="<%= imageHeaderUrl(:bg_desktop_size_1x, :title_bg) %>"
                    srcset="<%= imageHeaderUrl(:bg_desktop_size_2x, :title_bg) %> 2x,
                            <%= imageHeaderUrl(:bg_desktop_size_3x, :title_bg) %> 3x"
                >
            </picture>

        </figure>
        <figure class="tablet">

            <picture class="tablet">
                <img src="">
                <img
                    src="<%= imageHeaderUrl(:bg_tablet_size_1x, :title_bg_tablet) %>"
                    srcset="<%= imageHeaderUrl(:bg_tablet_size_2x, :title_bg_tablet) %> 2x,
                            <%= imageHeaderUrl(:bg_tablet_size_3x, :title_bg_tablet) %> 3x"
                >
            </picture>

        </figure>

    </div>

<% end %>
