
<%# typ = showsection_decide_titlebg_type(@portfolio) %>

<% typ = :responsive %>

<div class="preview responsive">
    <div class="bgs">

        <% if typ == :desktop %>

            <figure class="desktop">

                <picture class="pc">
                    <img
                        src="<%= imageHeaderUrl(:bg_desktop_size_1x) %>"
                        srcset="<%= imageHeaderUrl(:bg_desktop_size_2x) %> 2x,
                                <%= imageHeaderUrl(:bg_desktop_size_3x) %> 3x"
                    >
                </picture>

            </figure>

        <% elsif typ == :responsive %>

           <%= render('portfolios/show/title_bg/all_three') %>

        <% end %>

        <br>

    </div>

</div>


