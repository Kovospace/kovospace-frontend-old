
<nav class="show_work">

    <ul itemscope itemtype="http://schema.org/BreadcrumbList" class="breadcrumbs">

        <li itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a href="/" itemprop="item">
                <span itemprop="name"><em>Domov</em></span>
            </a>
            <meta itemprop="position" content="1" />
        </li>

        <li itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <%= link_to(@path_back, itemprop:"item") do %>
                <span itemprop="name">Tvorba</span>
            <% end %>
            <meta itemprop="position" content="2" />
        </li>

        <li itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a
                href="<%= @portfolio.link_sanitized %>"
                <%= @portfolio.style %>
                itemprop="item"
                target="_blank"
                class="fakehover"
            >
                <h2 itemprop="name">
                    <%= @portfolio.title %>
                </h2>
            </a>
            <meta itemprop="position" content="3" />
        </li>

    </ul>

    <ul class="preview_switcher">
        <li>
            <a href=""><span><em>1</em></span></a>
        </li>
        <li>
            <a href=""><span><em>2</em></span></a>
        </li>
        <li>
            <a href=""><span><em>3</em></span></a>
        </li>
    </ul>

</nav>