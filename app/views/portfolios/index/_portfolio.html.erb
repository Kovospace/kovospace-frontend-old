
<% @portfolios.each do |p| %>

    <article>

        <h2 class="lores">
            <%= link_to p.title, show_portfolio_path(p) %>
        </h2>

        <figure style="color:<%= p.theme_color %>;">
            <% if p.portfolio_screenshot.blank? %>

            <% else %>
                <picture>
                    <%= image_tag(p.portfolio_screenshot.screenshot.thumb) %>
                </picture>
            <% end %>
        </figure>

        <h2 class="hires">
            <%= link_to p.title, show_portfolio_path(p) %>
        </h2>

        <h3>
            <%= markdown p.intro %>
        </h3>

        <div class="portfolio_text_preview">
            <%= limit_lines(markdown(p.description)) %>
        </div>

        <div class="portfolio_actions">
            <div>
                <a href="<%= show_portfolio_url(p) %>" <%= p.style %> >
                    Dozvedieť sa viac
                </a>
                <a href="#" <%= p.style %> >
                    Galéria
                </a>
                <% if !p.link.blank? %>
                    <a  href="http://<%= p.link %>" <%= p.style %> >
                        Navštíviť web
                    </a>
                <% end %>
            </div>
        </div>

    </article>

<% end %>

