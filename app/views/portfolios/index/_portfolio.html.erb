
<% @portfolios.each do |p| %>



    <article>

        <h2 class="lores">
            <%= link_to p.title, show_portfolio_path(p) %>
        </h2>

        <figure style="color:<%= p.theme_color %>;">
            <% if p.portfolio_screenshot.blank? %>

            <% else %>
                <picture>
                    <source
                        media="(max-width: 360px)"
                        srcset="<%= imagePreviewUrl(p, :avatar_size_med_1x) %>,
                                <%= imagePreviewUrl(p, :avatar_size_med_2x) %> 2x,
                                <%= imagePreviewUrl(p, :avatar_size_med_3x) %> 3x"
                    >
                    <source
                        media="(max-width: 320px)"
                        srcset="<%= imagePreviewUrl(p, :avatar_size_small_1x) %>,
                                <%= imagePreviewUrl(p, :avatar_size_small_2x) %> 2x,
                                <%= imagePreviewUrl(p, :avatar_size_small_3x) %> 3x"
                    >
                    <img
                        src="<%= imagePreviewUrl(p, :avatar_size_1x) %>"
                        srcset="<%= imagePreviewUrl(p, :avatar_size_2x) %> 2x,
                                <%= imagePreviewUrl(p, :avatar_size_3x) %> 3x"
                    >
                </picture>
            <% end %>
        </figure>

        <h2 class="hires">
            <%= link_to p.title, show_portfolio_path(p) %>
        </h2>

        <h3>
            <%= markdown p.intro %>
        </h3>

        <div class="portfolio_text_preview">
            <%= limit_lines(markdown(p.description)) %>
        </div>

        <div class="portfolio_actions">
            <div>
                <a href="<%= show_portfolio_url(p) %>" <%= p.style %> >
                    Dozvedieť sa viac
                </a>
                <a href="#" <%= p.style %> >
                    Galéria
                </a>
                <% if !p.link.blank? %>
                    <a  href="http://<%= p.link %>" <%= p.style %> >
                        Navštíviť web
                    </a>
                <% end %>
            </div>
        </div>

    </article>

<% end %>

