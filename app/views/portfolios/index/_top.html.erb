<% content_for :top_menu do %>

    <nav>

        <ul>

            <li class="<%= active_link_to_class(home_path) %>">
                <%= active_link_to home_path do %>
                    <span>Domov</span>
                <% end %>
            </li>

            <li class="<%= active_link_to_class(blog_path) %>">
                <%= active_link_to blog_path do %>
                    <span>Blog</span>
                <% end %>
            </li>

            <li class="<%= active_link_to_class(portfolio_path) %>">
                <%= active_link_to portfolio_path do %>
                    <span>Tvorba</span>
                <% end %>
            </li>

        </ul>

        <ul>

            <li class="<%= active_link_to_class(portfolio_path) %> submenu">

                <ul>

                    <li><!--
                        --><%= link_to portfolio_path, class: 'title' do %><!--
                            --><b>Všetko</b><!--
                        --><% end %><!--
                        --><!--<br class="hideable">--><!--
                        --><%= active_link_to portfolio_path, class: 'number', active: is_sortlink_show_all_active? do %><!--
                            --><span>&nbsp;<%= Portfolio.all.size %>&nbsp;</span><!--
                        --><% end %><!--
                    --></li>

                    <% @skillsets.each do |skillset| %>
                        <li><!--
                            --><a href="<%= "#{portfolio_url}/#{skillset.slug}" %>"
                                  class="title"><!--
                                --><b><%= skillset.title %></b><!--
                            --></a><!--
                            --><!--<br class="hideable">--><!--
                            --><a href="<%= "#{portfolio_url}/#{skillset.slug}" %>"
                                  class="<%= active_class_for_sortlink(skillset) %> number "><!--
                                --><span>&nbsp;<%= skillset.portfolios.size %>&nbsp;</span><!--
                            --></a><!--
                        --></li>
                    <% end %>

                    <!--<li class="phantom"><%= @skillsets.last.title %></li>-->

                </ul>

            </li>

        </ul>

    </nav>

    <br class="clear">

<% end %>
