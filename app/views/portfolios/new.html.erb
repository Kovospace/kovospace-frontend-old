<%= form_for @portfolio do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>

    <div>
        <%= s.label :slug %>
        <%= s.text_field :slug %>
    </div>

    <div>
        <%= s.label :intro %>
        <%= s.text_area :intro %>
    </div>

    <div class="text_editor">
        <%= s.label :description %>
        <div class="trix_editor">
            <%= s.trix_editor :description, id: 'text' %>
        </div>
    </div>

    <div>
        <%= s.label :link %>
        <%= s.text_field :link %>
    </div>

    <div>
        <%= s.label :realis_date %>
        <%= s.date_select :realis_date, { discard_day: true } %>
    </div>

    <div class="checkboxes">
        <%= s.label :skills %>
        <div>
            <%= s.collection_check_boxes(
                :skill_ids,
                @skills_all,
                :id,
                :title
            ) do |checkbox| %>
                <span>
                    <%= checkbox.label %> <%= checkbox.check_box %>
                </span>
            <% end %>
        </div>
    </div>

    <div class="checkboxes">
        <%= s.label :categories %>
        <div>
            <%= s.collection_radio_buttons(
                :skillset_id,
                @skillsets_all,
                :id,
                :title
            ) do |radiobtn| %>
                <span>
                    <%= radiobtn.label %> <%= radiobtn.radio_button %>
                </span>
            <% end %>
        </div>
    </div>

    <div>
        <%= s.label :theme_color %>
        <%= s.text_field :theme_color %>
    </div>

    <div>
        <%= s.label :proirity %>
        <%= s.select :proirity,  options_for_select([ 1, 2, 3, 4, 5 ], @portfolio.proirity) %>
    </div>

    <div>
        <%= s.label :avatar %>
        <div class="pictures">
            <%= s.fields_for :portfolio_screenshot do |ps| %>
                <% blank = ps.object.screenshot.blank? %>

                <picture>
                    <%= ps.file_field :screenshot, class: "hidden" %>
                    <%= ps.hidden_field :screenshot_cache %>
                    <span>
                        <%= ps.label :screenshot do %>
                            <%= ps.check_box(:_destroy) if !blank %>
                            <%= image_tag(ps.object.screenshot) if !blank %>
                            <% if blank %> <q></q> <% end %>
                        <% end %>
                    </span>
                    <span>
                        <%= ps.text_area(:alt_text) %>
                    </span>
                </picture>

            <% end %>

            <br class="clear">
        </div>
    </div>

    <div>
        <%= s.label :title_bg_singles %>
        <div class="pictures">
            <%= s.fields_for :portfolio_titlebg_singles do |pbgs| %>
                <% blank = pbgs.object.title_bg.blank? %>

                <picture>
                    <%= pbgs.file_field :title_bg, class: "hidden" %>
                    <%= pbgs.hidden_field :title_bg_cache %>
                    <span>
                        <%= pbgs.label :title_bg do %>
                            <%= pbgs.check_box(:_destroy) if !blank %>
                            <%= image_tag(pbgs.object.title_bg) if !blank %>
                            <% if blank %> <q></q> <% end %>
                        <% end %>
                    </span>
                    <span>
                        <%= pbgs.text_area(:alt_text) %>
                    </span>
                </picture>

            <% end %>

            <br class="clear">
        </div>
    </div>

    <div>
        <%= s.label :title_bgs %>
        <div class="pictures">
            <%= s.fields_for :portfolio_titlebgs do |pbg| %>
                <%# blank = pbg.object.screenshot.blank? %>
                <%#= pbg_types %>

                <article>
                    <% pbg_types.each do |pbg_type|
                        obj_name = "title_bg#{pbg_type}"
                        blank = pbg.object.send(obj_name).blank? %>

                        <picture>
                            <%= pbg.file_field "#{obj_name}", class: "hidden" %>
                            <%= pbg.hidden_field "#{obj_name}_cache" %>
                            <span>
                                <%= pbg.label "#{obj_name}" do %>
                                    <%#= pbg.check_box(:_destroy) if !blank %>
                                    <%= image_tag(pbg.object.send(obj_name)) if !blank %>
                                    <% if blank %> <q></q> <% end %>
                                <% end %>
                                <%= pbg_type %>
                            </span>

                        </picture>

                    <% end %>

                    <div class="clear"></div>
                </article>

            <% end %>
        </div>
    </div>

    <div class="gallery">
        <%= s.label :images %>
        <div class="pictures">
            <% i = 0 %>
            <%= s.fields_for :portfolio_galleries do |ps| %>
                <%
                    blank = ps.object.image.blank?
                    i += 1
                    val = ps.object.identificator.nil? ? i : ps.object.identificator
                %>
                <picture>
                    <% if !blank %>
                        <em><%= val %></em>
                        <%= ps.label(:_destroy, "X", class: 'destroy') %>
                    <% end %>
                    <%= ps.file_field :image, class: "hidden" %>
                    <%= ps.hidden_field :image_cache %>
                    <%= ps.hidden_field :id %>
                    <%= ps.hidden_field :identificator, value: val, class: 'identificator' %>
                    <span>
                        <%= ps.label :image do %>
                            <%= ps.check_box(:_destroy, class: 'hidden') if !blank %>
                            <%= image_tag(ps.object.image) if !blank %>
                            <% if blank %> <q></q> <% end %>
                        <% end %>
                    </span>
                    <span>
                        <%= ps.text_area(:alt_text) %>
                    </span>
                    <span>
                        <i>Velkosť:</i>
                        <br>
                        <%= ps.hidden_field :typ, value: 0 %>
                        <%= ps.select(
                            :typ,
                            [
                                ["Do galérie", 0],
                                ["Naturálny", 1]
                            ]
                        ) %>
                    </span>
                </picture>
            <% end %>
        </div>
    </div>

    <br>

    <div>
        <%= s.submit %>
    </div>

<% end %>
