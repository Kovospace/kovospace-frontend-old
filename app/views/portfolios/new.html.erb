<%= form_for @portfolio do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>

    <div>
        <%= s.label :intro %>
        <%= s.text_area :intro %>
    </div>

    <div>
        <%= s.label :description %>
        <%= s.text_area :description %>
    </div>

    <div>
        <%= s.label :link %>
        <%= s.text_field :link %>
    </div>

    <div>
        <%= s.collection_check_boxes(
            :skill_ids,
            @skills_all,
            :id,
            :title
        ) do |checkbox| %>
            <span>
                <%= checkbox.label %> <%= checkbox.check_box %>
            </span>
        <% end %>
    </div>

    <div>
        <%#= s.file_field :screenshots, multiple: true %>
    </div>

    <div>

        <%= @portfolio_screenshots %>

        <% s.fields_for :portfolio_screenshots do |ps| %>

            <%= ps %>

            <%= ps.file_field :screenshot %>

        <% end %>

        <%# if !s.object.screenshots.nil? %>
            <%# s.object.screenshots.each_with_index do |screenshot, index| %>
                <picture>
                    <%#= s.check_box(
                        :remove_screenshot,
                        { multiple: true },
                        index,
                        nil
                    ) %>
                    <%#= image_tag(screenshot) %>
                </picture>
            <% #end %>
        <% #end %>
    </div>

    <br>

    <div>
        <%= s.submit %>
    </div>

<% end %>
