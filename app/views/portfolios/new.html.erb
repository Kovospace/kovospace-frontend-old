<%= form_for @portfolio do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>

    <div>
        <%= s.label :slug %>
        <%= s.text_field :slug %>
    </div>

    <div>
        <%= s.label :intro %>
        <%= s.text_area :intro %>
    </div>

    <div>
        <%= s.label :description %>
        <%= s.text_area :description %>
    </div>

    <div>
        <%= s.label :link %>
        <%= s.text_field :link %>
    </div>

    <div>
        <%= s.label :realis_date %>
        <%= s.date_select :realis_date, { discard_day: true } %>
    </div>

    <div>
        <%= s.collection_check_boxes(
            :skill_ids,
            @skills_all,
            :id,
            :title
        ) do |checkbox| %>
            <span>
                <%= checkbox.label %> <%= checkbox.check_box %>
            </span>
        <% end %>
    </div>

    <div>
        <%= s.collection_radio_buttons(
            :skillset_id,
            @skillsets_all,
            :id,
            :title
        ) do |radiobtn| %>
            <span>
                <%= radiobtn.label %> <%= radiobtn.radio_button %>
            </span>
        <% end %>
    </div>

    <div>
        <%= s.label :theme_color %>
        <%= s.text_field :theme_color %>
    </div>

    <% blank = s.object.title_bg.blank? %>
    <div>
        <picture>
            <%= s.file_field :title_bg, class: "hidden" %>
            <%= s.hidden_field :title_bg_cache %>
            <span>
                <%= s.label :title_bg do %>
                <%#= ps.check_box(:_destroy) if !blank %>
                <%= image_tag(s.object.title_bg) if !blank %>
                <% if blank %> <q></q> <% end %>
                <% end %>
            </span>

        </picture>
        <div class="clear">
    </div>


    <div>
        <%= s.fields_for :portfolio_screenshot do |ps| %>
            <% blank = ps.object.screenshot.blank? %>

            <picture>
                <%= ps.file_field :screenshot, class: "hidden" %>
                <%= ps.hidden_field :screenshot_cache %>
                <span>
                    <%= ps.label :screenshot do %>
                        <%= ps.check_box(:_destroy) if !blank %>
                        <%= image_tag(ps.object.screenshot) if !blank %>
                        <% if blank %> <q></q> <% end %>
                    <% end %>
                </span>
                <span>
                    <%= ps.text_area(:alt_text) %>
                </span>
            </picture>

        <% end %>

        <br class="clear">
    </div>

    <br>

    <div>
        <%= s.submit %>
    </div>

<% end %>
