<%= form_for @portfolio do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>

    <div>
        <%= s.label :intro %>
        <%= s.text_area :intro %>
    </div>

    <div>
        <%= s.label :description %>
        <%= s.text_area :description %>
    </div>

    <div>
        <%= s.label :link %>
        <%= s.text_field :link %>
    </div>

    <div>
        <%= s.collection_check_boxes(
            :skill_ids,
            @skills_all,
            :id,
            :title
        ) do |checkbox| %>
            <span>
                <%= checkbox.label %> <%= checkbox.check_box %>
            </span>
        <% end %>
    </div>

    <div>
        <%#= s.file_field :screenshots, multiple: true %>
    </div>

    <div>
        <%= s.fields_for :portfolio_screenshots do |ps| %>
            <% blank = ps.object.screenshot.blank? %>
            <picture>
                <%#= ps.file_field :screenshot, multiple: true, name: "portfolio_screenshots[screenshot][]" %>
                <%= ps.file_field :screenshot, class: "hidden" %>
                <%= ps.hidden_field :screenshot_cache %>
                <%= ps.label :screenshot do %>
                    <%= image_tag(ps.object.screenshot) if !blank %>
                    <%= ps.check_box(:remove_screenshot) if !blank %>
                <% end %>
            </picture>
        <% end %>
    </div>

    <br>

    <div>
        <%= s.submit %>
    </div>

<% end %>
