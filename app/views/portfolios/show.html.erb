
<% content_for :head do %>

    <%= canonical_tag show_portfolio_url(@portfolio) %>

    <style>
        nav.show_work ul.prewiew_switcher li a.active,
        nav.show_work ul li a.active {
            <%= @portfolio.style_css %>
        }
        main section#show_work article div ul li:before {
            <%= @portfolio.style_css_fg_only_inverted %>
        }
        main section#show_work article div figure picture img {
            border-color: #<%= @portfolio.bg_color %>;
        }
    </style>

<% end %>

<% content_for :top_menu do %>

    <%= render 'portfolios/show/title_bg' %>
    <%= render 'portfolios/show/top' %>

<% end %>

<section id="show_work">

    <%= render 'portfolios/show/article' %>

</section>


