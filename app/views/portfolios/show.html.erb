
<% content_for :head do %>

    <%= canonical_tag show_portfolio_url(@portfolio) %>

<% end %>

<header class="portfolios show">
    <%= render 'portfolios/show/title_bg' %>
</header>

<main>
    <section id="show_work">

        <%#= render 'portfolios/show/title_bg' %>

        <article>
             <h2> <%= @portfolio.title %> </h2>
             <%= @portfolio.description %>
        </article>

    </section>
</main>
