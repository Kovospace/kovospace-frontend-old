
<% content_for :head do %>

    <%= canonical_tag show_portfolio_url(@portfolio) %>

<% end %>

<%= render 'portfolios/show/title_bg' %>

<section id="show_work">

    <article>

        <h2>
            <a href="" <%= @portfolio.style %>>
                <%= @portfolio.title %>
            </a>
        </h2>
        <h3>
            <%= markdown @portfolio.intro %>
        </h3>
        <p>
        <br>
        <%= markdown(@portfolio.description) %>

    </article>

</section>

