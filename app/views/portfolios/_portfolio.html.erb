
<% @portfolios.each do |p| %>

    <article>

        <h2>
            <%= link_to p.title, p %>

            <%# if p.link.blank? %>
                <%#= p.title %>
            <%# else %>
                <!--<a href="http://<%= p.link %>"> <%= p.title %> </a>-->
            <%# end %>
        </h2>

        <figure>
            <picture>
                <img src="">
            </picture>
        </figure>

        <h3>
            <%= markdown p.intro %>
        </h3>

        <div class="portfolio_text_preview">
            <%= limit_lines(markdown(p.description)) %>
        </div>

        <div class="portfolio_actions">
            <div>
                <a href="#">Dozvedieť sa viac</a>
                <a href="#">Galéria</a>
                <a href="#">Navštíviť web</a>
            </div>
        </div>

    </article>

<% end %>

