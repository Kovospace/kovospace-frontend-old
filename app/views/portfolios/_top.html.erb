<% content_for :header do %>

    <nav>

        <ul>

            <li class="<%= active_link_to_class(home_path) %>">
                <%= active_link_to home_path do %>
                    <span>Domov</span>
                <% end %>
            </li>

            <li class="<%= active_link_to_class(blog_path) %>">
                <%= active_link_to blog_path do %>
                    <span>Blog</span>
                <% end %>
            </li>

            <li class="<%= active_link_to_class(portfolio_path) %>">
                <%= active_link_to portfolio_path do %>
                    <span>Tvorba</span>
                <% end %>
            </li>

        </ul>

        <ul>

            <li class="<%= active_link_to_class(portfolio_path) %>">

                <ul>

                    <li><!--
                        --><%= active_link_to portfolio_path, class: 'title' do %><!--
                            --><b>Všetko</b><!--
                        --><% end %><!--
                        --><br><!--
                        --><%= active_link_to portfolio_path do %><!--
                            --><span><%= @portfolios.all.size %></span><!--
                        --><% end %><!--
                    --></li>

                    <% @skillsets.each do |skillset| %>
                        <li><!--
                            --><a href="#" class="title"><!--
                                --><b><%= skillset.title %></b><!--
                            --></a><!--
                            --><br><!--
                            --><a href="#"><!--
                                --><span><%= skillset.portfolios.size %></span><!--
                            --></a><!--
                        --></li>
                    <% end %>

                </ul>

            </li>

        </ul>

    </nav>

    <br class="clear">

<% end %>
