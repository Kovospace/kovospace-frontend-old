
<%
    klass = "" if klass.nil?
    args =  {
                blog_id: @blog,
                category_id: @category,
                page: params[:page],
                post_id: @post,
                id: params[:id]
            }
    url = klass.blank? ? add_comment_path(args) : add_reply_path(args)
%>

<article id="new_comment" class="<%= klass %>">

    <%= form_for(@comment, url: url, method: :post) do |p| %>

        <% if current_user %>

            <div>
                <%= p.text_area :comment %>
                <%= p.errors :comment %>
            </div>

            <%= p.hidden_field :reply_to, value: @relation_id %>

        <% else %>

            <div></div>

        <% end %>

        <div class="submit">
            <%= p.submit %>
        </div>

    <% end %>

</article>


