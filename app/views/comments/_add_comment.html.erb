
<%
    klass = "" if klass.nil?
    args = {
        blog_id: @blog,
        category_id: @category,
        page: params[:page],
        post_id: @post,
        id: (path == :add_comment ? nil : params[:id])
    }
    if path == :add_comment
         reply_to_html_id = "comments"
    elsif path == :add_reply
        reply_to_html_id = @relation_id.sub(/-[0-9]+$/, "")
    end
    args.merge!({ anchor: reply_to_html_id })
    url = public_send(path.to_s+"_path", args)
%>

<article id="new_comment" class="<%= klass %>">

    <%= form_for(@comment, url: url, method: typ) do |p| %>

        <% if current_user %>

            <div>
                <%= p.text_area :comment %>
                <%= p.errors :comment %>
            </div>

            <%= p.hidden_field :reply_to, value: @relation_id %>

            <div class="submit">
                <%= p.submit %>
                <%= link_to(
                    "Storno",
                    show_comments_path(@blog, @category, params[:page], @post, anchor: reply_to_html_id),
                    class: "storno"
                ) %>
            </div>

        <% else %>


        <% end %>

    <% end %>

</article>


