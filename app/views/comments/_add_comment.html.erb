
<% klass = "" if klass.nil? %>

<article id="new_comment" class="<%= klass %>">

    <%= form_for(
        @comment,
        url: add_comment_path(
                blog_id: @blog,
                category_id: @category,
                page: params[:page],
                post_id: @post
            ),
        method: :post
    ) do |p| %>

            <% if current_user %>

                <div>
                    <%#= p.label :comment %>
                    <%= p.text_area :comment %>
                    <%= p.errors :comment %>
                </div>

                <%= p.hidden_field :reply_to, value: @relation_id %>

            <% else %>

                <div></div>

            <% end %>

        <div class="submit">
            <%= p.submit %>
        </div>

    <% end %>

</article>


