<article id="new_comments">

    <% if (@comments.length == 0)#||(@comments.all.blank?) %>

        <div class="comment">
            <span>
                <b> Zatiaľ neboli k článku pridané žiadne komentáre </b>
            </span>
        </div>

    <% else %>

        <% @comments.each do |comment| %>

            <% if !comment.id.blank? %>

                <%
                    class_append = (comment.user == current_user) ? "my" : ""
                    class_append += " replying" if comment.id == params[:id].to_i
                    deepness = comment.relation_id.to_s.count('-')
                    margin = (deepness > 6) ? 6 : deepness
                    class_append += " sub#{margin}"
                %>

                <div class="comment <%= class_append %>">

                    <a class="anchor" id="<%= comment.relation_id %>"></a>

                    <div>
                        <b> <%= comment.user.name %> </b>
                    </div>
                    <div>
                        <i> <%= comment.created_at.strftime("%A %e. %B %Y, %H:%M") %> </i>
                    </div>

                    <div>
                        <% if user_signed_in? %>

                            <% if comment.user == current_user %>
                                <%= link_to(
                                    "Upraviť",
                                    edit_my_comment_path(
                                        @blog,
                                        @category,
                                        params[:page],
                                        @post,
                                        comment.id,
                                        anchor: comment.relation_id
                                    )
                                ) %>
                                <%= link_to(
                                    "Odstrániť",
                                    destroy_my_comment_path(comment.id),
                                    method: :delete,
                                    class: "danger"
                                ) %>
                                <noscript>

                                </noscript>
                            <% end %>

                            <%= link_to(
                                    reply_to_comment_path(@blog, @category, params[:page], @post, comment.id, anchor: comment.relation_id)
                                ) do %>
                                    <b> Odpovedať </b>
                            <% end %>

                        <% end %>
                    </div>

                    <br>
                    <span>
                        <%= comment.comment %>
                    </span>
                </div>


                <% if comment.id == params[:id].to_i %>

                    <% if (action_name=="reply_to_comment")||(action_name=="create_reply") %>

                        <%= render(
                            'comments/add_comment',
                            klass: class_append,
                            path: :add_reply,
                            typ: :post
                        ) %>

                    <% elsif action_name == "edit_my_comment" %>

                        <%= render(
                            'comments/add_comment',
                            klass: class_append,
                            path: :update_my_comment,
                            typ: :patch
                        ) %>

                    <% end %>

                <% end %>

            <% end %>

        <% end %>

    <% end %>

</article>



