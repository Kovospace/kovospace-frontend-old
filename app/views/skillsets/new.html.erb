<%= form_for @skillset do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>
    <div>
        <%= s.label :slug %>
        <%= s.text_field :slug %>
    </div>
    <div>
        <%= s.label :description %>
        <%= s.text_area :description %>
    </div>

    <div>
        <%= s.submit %>
    </div>

<% end %>
