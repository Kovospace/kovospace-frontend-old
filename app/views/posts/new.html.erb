<%= form_for @post do |p| %>

	<section>
		<article>
			<%= p.label :title %>
			<%= p.text_field :title %>
			<%= p.errors :title %>
		</article>
		<article>
			<%= p.label :text %>
			<%= p.text_area :text %>
			<%= p.errors :text %>
		</article>
	</section>

	<br>

	<section>
		<article>
			<%= p.collection_check_boxes(
				:category_ids,
				@categories_all,
				:id,
				:title
			) %>
		</article>
		<br>
		<article>
			<%= p.fields_for :categories, @categories do |t| %>
				<%= t.label :title %>
				<%= t.text_field :title %>
				<%= t.errors :title %>
			<% end %>
		</article>
	</section>

	<br>

	<section>
		<article>
			<%= p.collection_check_boxes(
				:tag_ids,
				@tags_all,
				:id,
				:title
			) %>
		</article>
		<br>
		<article>
			<%= p.fields_for :tags, @tags do |t| %>
				<%= t.label :title %>
				<%= t.text_field :title %>
				<%= t.errors :title %>
			<% end %>
		</article>
	</section>
	
	<br>

	<section>
		<article>
			<%= p.submit %>
		</article>
	</section>
	
<% end %>