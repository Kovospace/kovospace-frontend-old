<%= form_for @post do |p| %>

	<div>
		<%= p.label :title %>
		<%= p.text_field :title %>
		<%#= p.errors :title %>
	</div>

	<div>
		<%= p.label :text %>
		<%#= p.text_area :text %>
		<%= p.cktext_area :text %>
		<%#= p.errors :text %>
	</div>

	<div>
		<%= p.collection_check_boxes(
			:category_ids,
			@categories_all,
			:id,
			:title
		) %>
	</div>

	<div>
		<%= p.fields_for :categories, @categories do |t| %>
			<% if t.object.id.blank? %>
				<%= t.label :title %>
				<%= t.text_field :title %>
				<%#= t.errors :title %>
			<% end %>
		<% end %>
		<%#= render(
			'layouts/shared_elements/form_errors_field',
			field: :categories_attributes
		) %>
	</div>

	<div>
		<%= p.collection_check_boxes(
			:tag_ids,
			@tags_all,
			:id,
			:title
		) %>
	</div>

	<div>
		<%= p.fields_for :tags, @tags do |t| %>
			<% if t.object.id.blank? %>
				<%= t.label :title %>
				<%= t.text_field :title %>
				<%#= t.errors :title %>
			<% end %>
		<% end %>
		<%#= render(
			'layouts/shared_elements/form_errors_field',
			field: :tags_attributes
		) %>
	</div>

	<div>
		<%= p.submit %>
	</div>

<% end %>
