<%= form_for @post do |p| %>

	<div>
		<%= p.label :title %>
		<%= p.text_field :title %>
		<%= p.errors :title %>
	</div>

	<div>
		<%= p.label :slug %>
		<%= p.text_field :slug %>
		<%= p.errors :slug %>
	</div>

    <div>
        <%= p.text_area :intro %>
        <%= p.errors :intro %>
    </div>

	<div>
		<%= p.label :text %>
		<%#= p.text_area :text %>
		<%= p.cktext_area :text %>
		<%#= p.errors :text %>
	</div>

	<div>
        <%= p.label :avatar %>
        <%= p.file_field :avatar %>
        <%= p.hidden_field :avatar_cache %>
    </div>

    <div class="picture">
        <%= p.label :avatar %>
        <picture>
            <%= p.label :avatar do %>
                <%= image_tag(p.object.avatar) if !p.object.avatar.nil? %>
            <% end %>
        </picture>
    </div>

	<div class="checkboxes">
		<%= p.label :categories %>
		<div>
			<%= p.collection_check_boxes(
				:category_ids,
				@categories_all,
				:id,
				:title
			) do |checkbox| %>
                <span>
                    <%= checkbox.label %> <%= checkbox.check_box %>
                </span>
            <% end %>
		</div>
	</div>

	<div>
		<%= p.fields_for :categories, @categories do |t| %>
			<% if t.object.id.blank? %>
				<%= t.label :title %>
				<%= t.text_field :title %>
				<%#= t.errors :title %>
			<% end %>
		<% end %>
		<%#= render(
			'layouts/shared_elements/form_errors_field',
			field: :categories_attributes
		) %>
	</div>

	<div class="checkboxes">
		<%= p.label :tags %>
		<div>
			<%= p.collection_check_boxes(
				:tag_ids,
				@tags_all,
				:id,
				:title
			) do |checkbox| %>
                <span>
                    <%= checkbox.label %> <%= checkbox.check_box %>
                </span>
            <% end %>
		</div>
	</div>

	<div>
		<%= p.fields_for :tags, @tags do |t| %>
			<% if t.object.id.blank? %>
				<%= t.label :title %>
				<%= t.text_field :title %>
				<%#= t.errors :title %>
			<% end %>
		<% end %>
		<%#= render(
			'layouts/shared_elements/form_errors_field',
			field: :tags_attributes
		) %>
	</div>

	<br>

	<div>
		<%= p.submit %>
	</div>

<% end %>
