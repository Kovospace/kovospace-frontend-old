<%= t_link_to :create_article, new_post_path %>

<br><br>

<% @posts.each do |post| %>

	<%= post.title %> 

	<%= t_link_to :edit_article, edit_post_path(post) %>

	<%= t_link_to :delete_article, destroy_post_path(post.id), method: :delete, :confirm => "Are you sure ?", remote: true %>
	<br>

<% end %>