
<%= render('blogs/show/top',
    klass: (params[:category_id].blank? ? "maximized" : "minimized"),
    blog_id: :id,
    post_id: :post_id,
    category_id: :category_id
) %>

<section class="posts all">

    <% @posts.all.each do |p| %>

        <%= render "blogs/show/post", p: p %>

    <% end %>

</section>

<section class="pagination">
    <%= paginate @posts %>
</section>

