<% content_for :head do %>
    <%= canonical_tag show_post2_url(@post) %>
<% end %>

<% #minimized_menu = (controller_name == "posts")||(!params[:category_id].blank?) %>

<% content_for :header do %>
    <%= render('posts/show/admin_notice_not_published') if !@post.published %>
<% end %>

<%= render(
    'blogs/show/top',
    klass: (params[:category_id].blank? ? "maximized" : "minimized")
) %>

<%= render 'posts/show/title_bg' %>

<%= render 'posts/show/title' %>

<section id="show_post">
    <article>
        <div> <%= @post.text.html_safe %> </div>
    </article>
</section>

<%= render('posts/show/next_serial') if @category&&@blog %>

<section id="comments">
    <h3>Diskusia</h3>
    <%= render('comments/add_comment') %>
    <%= render('comments/comments') %>
</section>

