
<div class="left">
    <span> <b>&#9400;</b> 2018 Matej Kováč </span>
</div>

<div class="right">

    <%= link_to(
        "GDPR",
        gdpr_path,
        rel: "nofollow"
    ) %>

    <%= link_to(
        "Cookies",
        cookies_path,
        rel: "nofollow"
    ) %>

    <%= link_to "sitemap", user_sitemap_path %>

    <%= link_to(
        "login",
        user_session_path,
        rel: "nofollow"
    ) if !user_signed_in? %>

    <%= link_to(
        "logout",
        destroy_user_session_path,
        method: :delete,
        rel: "nofollow"
    ) if user_signed_in? %>

    <%= link_to(
        "admin",
        admin_path,
        rel: "nofollow"
    ) if (user_signed_in?)&&(current_user.role==1) %>


</div>

