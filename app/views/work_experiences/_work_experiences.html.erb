<div class="tablewrap" id="work_experiences_table">

	<% @work_experience_past.each do |item| %>

		<div>
			<span> <%= l(item.start, format: '%m/%Y') %> <%= "-" if !item.end.nil? %> <%= l(item.end, format: '%m/%Y') if !item.end.nil? %> </span>
			<br>
			<span> <%= item.title %> <%= link_to(item.web, "https://" + item.web) %> </span>
			<br>
			<span> <i> <%= item.position %> </i> </span>
		</div>

	<% end %>

</div>
