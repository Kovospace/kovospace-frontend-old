<%= form_for @work_experience do |s| %>

    <div>
        <%= s.label :title %>
        <%= s.text_field :title %>
    </div>
    <div>
        <%= s.label :position %>
        <%= s.text_field :position %>
    </div>
    <div>
        <%= s.label :place %>
        <%= s.text_field :place %>
    </div>
    <div>
        <%= s.label :web %>
        <%= s.text_field :web %>
    </div>
    <div>
        <%= s.label :start %>
        <%= s.date_select :start %>
    </div>
    <div>
        <%= s.label :end %>
        <%= s.date_select :end %>
    </div>

    <div>
        <%= s.submit %>
    </div>

<% end %>
